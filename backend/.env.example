CORS_ORIGINS=http://localhost:3000

CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET=
CLOVA_SPEECH_LANGUAGE=ko-KR
CLOVA_SPEECH_TIMEOUT=180

LOCAL_TTS_MODEL=supertonic-3
LOCAL_TTS_MODEL_DIR=models/tts/supertonic3
LOCAL_TTS_NUM_THREADS=2
LOCAL_TTS_DEFAULT_VOICE=M1
LOCAL_TTS_STEPS=8
LOCAL_TTS_SPEED=1.05

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Change LLM_PROVIDER only (anthropic / gemini), then fully restart the backend.
# Settings and clients are cached; --reload does not reliably reload .env.
ANTHROPIC_EVAL_MODEL=claude-sonnet-5
ANTHROPIC_PERSONALIZE_MODEL=claude-haiku-4-5-20251001
GEMINI_EVAL_MODEL=gemma-4-31b-it
GEMINI_PERSONALIZE_MODEL=gemma-4-31b-it
# Legacy overrides: leave empty when switching providers.
# Priority: selected provider's model > legacy override > provider default.
EVAL_MODEL=
PERSONALIZE_MODEL=

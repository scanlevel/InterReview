{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interreview.local/schemas/benchmark_sample.schema.json",
  "title": "InterReview Benchmark Sample v1.0",
  "type": "object",
  "required": ["benchmark_version", "sample_id", "source", "question", "answer", "annotations", "gold", "benchmark_split"],
  "properties": {
    "benchmark_version": {"const": "1.0"},
    "sample_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["dataset", "answer_attached"],
      "properties": {
        "dataset": {"type": "string"},
        "experience": {"enum": ["NEW", "EXPERIENCED", null]},
        "source_question_id": {"type": ["string", "null"]},
        "source_answer_id": {"type": ["string", "null"]},
        "source_file": {"type": ["string", "null"]},
        "bank_file": {"type": ["string", "null"]},
        "occurrence_count": {"type": ["integer", "null"]},
        "answer_intent": {"type": ["object", "null"]},
        "answer_attached": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "question": {
      "type": "object",
      "required": ["text", "group", "group_name", "specialized_metric"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "group": {"type": "string", "minLength": 1},
        "group_name": {"type": "string", "minLength": 1},
        "specialized_metric": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "answer": {
      "type": "object",
      "required": ["text"],
      "properties": {"text": {"type": "string"}},
      "additionalProperties": false
    },
    "annotations": {
      "type": "array",
      "items": {"$ref": "#/$defs/annotation"}
    },
    "gold": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/gold"}]},
    "benchmark_split": {"enum": ["train", "validation", "test", null]}
  },
  "additionalProperties": false,
  "$defs": {
    "scores": {
      "type": "object",
      "required": ["relevance", "specificity", "coherence", "specialized"],
      "properties": {
        "relevance": {"type": "integer", "minimum": 0, "maximum": 2},
        "specificity": {"type": "integer", "minimum": 0, "maximum": 2},
        "coherence": {"type": "integer", "minimum": 0, "maximum": 2},
        "specialized": {"type": "integer", "minimum": 0, "maximum": 2}
      },
      "additionalProperties": false
    },
    "annotation": {
      "type": "object",
      "required": ["annotator_id", "rubric_version", "scores", "confidence", "note"],
      "properties": {
        "annotator_id": {"type": "string", "format": "uuid"},
        "rubric_version": {"type": "string", "minLength": 1},
        "scores": {"$ref": "#/$defs/scores"},
        "confidence": {"type": "integer", "minimum": 0, "maximum": 2},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "gold": {
      "type": "object",
      "required": ["scores", "total_score", "agreement", "adjudicated", "rubric_version"],
      "properties": {
        "scores": {"$ref": "#/$defs/scores"},
        "total_score": {"type": "integer", "minimum": 0, "maximum": 8},
        "agreement": {
          "type": "object",
          "required": ["relevance", "specificity", "coherence", "specialized"],
          "properties": {
            "relevance": {"type": "boolean"},
            "specificity": {"type": "boolean"},
            "coherence": {"type": "boolean"},
            "specialized": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "adjudicated": {"type": "boolean"},
        "rubric_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
